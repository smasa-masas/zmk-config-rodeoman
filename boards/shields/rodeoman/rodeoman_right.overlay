#include "rodeoman.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

&default_transform {
    col-offset = <5>;
};

&trackball_split {
    device = <&trackball>;
    /*
     * The AZ1UBALL V2 sensor is physically mounted in a mirrored orientation,
     * so invert both X and Y pointer movement before it reaches the host.
     */
    input-processors =
        <&zip_xy_scaler 8 1>
        , <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>
        ;
};

&xiao_i2c {
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;
    trackball: trackball@a {
        compatible = "palette,az1uball";
        reg = <0x0A>;
        status = "okay";
    };
};
