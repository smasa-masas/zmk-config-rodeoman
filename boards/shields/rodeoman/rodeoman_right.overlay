#include "rodeoman.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

&default_transform {
    col-offset = <5>;
};

&trackball_split {
    device = <&trackball>;
    /*
     * AZ1UBALL V2 is mounted with its axes reversed relative to the expected
     * cursor directions. Use the dedicated X/Y axis inversion processors so
     * pointer motion follows the physical ball movement instead of its mirror
     * image.
     */
    input-processors =
        <&zip_xy_scaler 8 1>
        , <&zip_x_invert>
        , <&zip_y_invert>
        ;
};

&xiao_i2c {
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;
    trackball: trackball@a {
        compatible = "palette,az1uball";
        reg = <0x0A>;
        status = "okay";
    };
};
